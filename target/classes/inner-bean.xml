<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <bean name="address" class="com.learning.model.Address" >
    
      <property name="city" value="GZB"></property>
      <property name="state" value="U.P"></property>
    
    </bean>
   
    <bean name="emp1" class="com.learning.model.Employee" autowire="byType" scope="prototype">
    
     <property name="id" value="111"/>
     <property name="name" value="Himanshu"/>
     <property name="gender" value="Male"/>
     <property name="salary" value="100023"/>
     <property name="address">
     
        <bean class="com.learning.model.Address">
            <property name="city" value="Noida"></property>
            <property name="state" value="U.P"></property>
        </bean>
        
     </property>
    
    </bean> 

</beans>